generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------------
// ENUMS
// -------------------------------------------------------------

enum TransactionType {
  RECEIVE   // รับเข้า
  ISSUE     // จ่ายออก
}

// -------------------------------------------------------------
// MODELS
// -------------------------------------------------------------

model OrganizationInfo {
  id          String   @id @default(cuid())
  officeName  String   // ชื่อส่วนราชการ
  department  String   // หน่วยงาน
  district    String   // อำเภอ
  province    String   // จังหวัด
  fiscalYear  String   // ปีงบประมาณ
  coordinator String?  // ชื่อผู้ประสานงาน/เจ้าหน้าที่พัสดุ
  updatedAt   DateTime @updatedAt

  @@map("organization_info")
}

model Category {
  id          String           @id @default(cuid())
  name        String           @unique // เช่น วัสดุสำนักงาน, วัสดุไฟฟ้าและวิทยุ, วัสดุงานบ้านงานครัว, วัสดุก่อสร้าง, วัสดุยานพาหนะ
  
  items       ConsumableItem[]

  @@map("categories")
}

model Unit {
  id          String           @id @default(cuid())
  name        String           @unique // เช่น ชิ้น, เล่ม, รีม, กล่อง
  
  items       ConsumableItem[]

  @@map("units")
}

model ConsumableItem {
  id             String                  @id @default(cuid())
  categoryId     String
  category       Category                @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  
  unitId         String?
  unit           Unit?                   @relation(fields: [unitId], references: [id], onDelete: Restrict)
  
  name           String                  // ชื่อวัสดุ
  specification  String?                 // ขนาด/ลักษณะ/รายละเอียด
  unitName       String?                 // Fallback for existing data / legacy string unit

  unitPrice      Decimal?                @db.Decimal(12, 2) // ราคาต่อหน่วย
  balanceForward Int                     @default(0) // ยอดยกมา (จำนวนเริ่มต้น)
  minStock       Int                     @default(0) // จุดสั่งซื้อ/เตือนขั้นต่ำ
  imageUrl       String?                 // รูปภาพวัสดุ
  
  transactions   ConsumableTransaction[]

  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@map("consumable_items")
}

model ConsumableTransaction {
  id                  String          @id @default(cuid())
  itemId              String
  item                ConsumableItem  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  
  type                TransactionType // RECEIVE | ISSUE
  date                DateTime        @default(now()) // วันเดือนปี ที่รับ/จ่าย
  quantity            Int             // จำนวนรับ/จ่าย
  sourceOrDestination String?         // รับจาก (ชื่อร้าน/หน่วยงาน) หรือ จ่ายให้ (ชื่อผู้เบิก/หน่วยงาน)
  documentNo          String?         // เลขที่เอกสาร/ใบสั่งซื้อ/ใบเบิก
  notes               String?         // หมายเหตุ
  
  createdAt           DateTime        @default(now())

  @@index([itemId])
  @@index([type])
  @@index([date])
  @@map("consumable_transactions")
}
